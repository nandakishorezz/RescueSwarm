+// Phase-2C pose-source-time sidecar (SITL only).  Emits ONLY message identity +
+// ArduPilot simulation source time for the estimator telemetry message being
+// serialized by the caller.  Contains NO pose values, so it can never
+// reconstruct aircraft state.  ap_sim_us is the ArduPilot sim epoch (SIM loop
+// time_now_us, refreshed from fill_fdm each FDM) captured at the send point --
+// NOT the wall-fallback micros64.  seq is read from the channel status BEFORE
+// serialization, i.e. it is exactly the sequence the receiver will see in the
+// message header.  Inert unless SIM_JSON_CLOCK_WITNESS_PORT is set.
+static void emit_pose_source_witness(const mavlink_channel_t chan, const uint32_t msgid, const uint32_t ap_boot_ms)
+{
+#if CONFIG_HAL_BOARD == HAL_BOARD_SITL
+    const char *wport = getenv("SIM_JSON_CLOCK_WITNESS_PORT");
+    if (wport != nullptr) {
+        static int posesock = -1;
+        if (posesock == -1) {
+            posesock = socket(AF_INET, SOCK_DGRAM, 0);
+            if (posesock >= 0) { int rz = 1; setsockopt(posesock, SOL_SOCKET, SO_REUSEADDR, &rz, sizeof(rz)); }
+        }
+        if (posesock >= 0) {
+            mavlink_status_t *ps = mavlink_get_channel_status(chan);
+            const uint8_t pseq = (ps != nullptr) ? ps->current_tx_seq : 0;
+            SITL::SIM *psitl = AP::sitl();
+            const uint64_t ap_sim_us = SITL::ap_sim_source_time_now_us.load(std::memory_order_relaxed);
+            const uint64_t ap_sim_fdm_us = (psitl != nullptr) ? psitl->state.timestamp_us : 0;
+            char pbuf[512];
+            snprintf(pbuf, sizeof(pbuf),
+                                          "{ \"kind\":\"pose_src_time\",\"msgid\":%u,\"chan\":%u,\"seq\":%u,\"ap_boot_ms\":%u,\"sysid\":%u,\"compid\":%u,\"ap_sim_us\":%llu,\"ap_sim_fdm_us\":%llu }",
+                     (unsigned)msgid, (unsigned)chan, (unsigned)pseq, (unsigned)ap_boot_ms,
+                     (unsigned)mavlink_system.sysid, (unsigned)mavlink_system.compid,
+                     (unsigned long long)ap_sim_us, (unsigned long long)ap_sim_fdm_us);
+            struct sockaddr_in psa; memset(&psa, 0, sizeof(psa));
+            psa.sin_family = AF_INET; psa.sin_port = htons((uint16_t)strtol(wport, nullptr, 10));
+            psa.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+            sendto(posesock, pbuf, strlen(pbuf), 0, (struct sockaddr *)&psa, sizeof(psa));
+        }
+    }
+#endif
+}
