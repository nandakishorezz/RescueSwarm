+/* ---- Phase-2 time-debug instrumentation (SITL only) ---- */
+namespace {
+__attribute__((unused))
+void mavlink_gpi_trace_append(uint8_t chan, int fd, int port, const char *layer,
+                      const uint8_t *buf, size_t len) {
+    static int logfd = -1;
+    static unsigned lines = 0;
+    if (logfd < 0) {
+        logfd = ::open("/tmp/mavlink_wire_trace.jsonl",
+                       O_WRONLY | O_CREAT | O_APPEND, 0644);
+    }
+    if (logfd < 0 || lines >= 20000) {
+        return;
+    }
+    size_t pos = 0;
+    while (pos + 8 <= len && lines < 20000) {
+        uint8_t tag = buf[pos];
+        size_t hdr, body, total;
+        unsigned msgid;
+        uint8_t seq, sid, cid;
+        if (tag == 0xFD) {
+            if (pos + 12 > len) break;
+            msgid = (unsigned)buf[pos+7] | ((unsigned)buf[pos+8] << 8) | ((unsigned)buf[pos+9] << 16);
+            body = buf[pos+1];
+            hdr = 10;
+            total = 12 + body;
+            seq = buf[pos+4];
+            sid = buf[pos+5];
+            cid = buf[pos+6];
+        } else if (tag == 0xFE) {
+            if (pos + 8 > len) break;
+            msgid = buf[pos+5];
+            body = buf[pos+1];
+            hdr = 6;
+            total = 8 + body;
+            seq = buf[pos+2];
+            sid = buf[pos+3];
+            cid = buf[pos+4];
+        } else {
+            pos++;
+            continue;
+        }
+        if (pos + total > len) break;
+        if (msgid == 33 && body >= 4) {
+            uint32_t boot = (uint32_t)buf[pos+hdr] | ((uint32_t)buf[pos+hdr+1] << 8)
+                          | ((uint32_t)buf[pos+hdr+2] << 16) | ((uint32_t)buf[pos+hdr+3] << 24);
+            struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+            const unsigned long long now_ns =
+                (unsigned long long)ts.tv_sec * 1000000000ULL + (unsigned long long)ts.tv_nsec;
+            char line[256];
+            int want = snprintf(line, sizeof(line),
+                "{\"l\":\"%s\",\"fd\":%d,\"port\":%u,\"chan\":%u,"
+                "\"boot\":%u,\"seq\":%u,\"sysid\":%u,\"compid\":%u,"
+                "\"body\":%u,\"v\":%d,\"wsl_ns\":%llu,\"head\":\"%02x%02x%02x%02x%02x%02x%02x%02x\"}\n",
+                layer, fd, (unsigned)port, (unsigned)chan,
+                boot, seq, sid, cid, (unsigned)body,
+                (tag==0xFD)?2:1, now_ns,
+                buf[pos+0], buf[pos+1], buf[pos+2], buf[pos+3],
+                buf[pos+4], buf[pos+5], buf[pos+6], buf[pos+7]);
+            int off = want;
+            if (off >= (int)sizeof(line)) {
+                off = (int)sizeof(line) - 1;
+            }
+            if (off < 0) {
+                off = 0;
+            }
+            ssize_t w = ::write(logfd, line, off);
+            (void)w;
+            lines++;
+        }
+        pos += total;
+    }
+}
+}
+/* ---- end Phase-2 time-debug instrumentation ---- */
