# Optional override used by shell scripts and local tooling.
# Never commit secrets or mission coordinates.
RESCUESWARM_CONFIG=config/prototype.yaml
MAVLINK_CONNECTION=/dev/serial0
MAVLINK_BAUD=57600

# Stage 2 ground server. Keep secrets in a local .env, never source control.
RESCUESWARM_GROUND_CONFIG=config/ground.yaml
RESCUESWARM_DATABASE_URL=sqlite:///data/ground/rescue_swarm.db
RESCUESWARM_AP_PASSWORD=replace-with-a-strong-local-password

# Stage 3: external official ArduPilot checkout (Linux/WSL path).
ARDUPILOT_HOME=/home/your-user/ardupilot
