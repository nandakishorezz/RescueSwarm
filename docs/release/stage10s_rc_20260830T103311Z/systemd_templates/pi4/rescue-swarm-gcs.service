[Unit]
Description=RescueSwarm Offline Ground Control System
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=rescueswarm
Group=rescueswarm
WorkingDirectory=/opt/rescueswarm
EnvironmentFile=/etc/rescueswarm/ground.env
ExecStart=/opt/rescueswarm/.venv/bin/uvicorn ground.backend.app.main:create_app --factory --host 10.42.0.1 --port 80 --workers 1
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rescueswarm/data /var/log/rescueswarm

[Install]
WantedBy=multi-user.target
